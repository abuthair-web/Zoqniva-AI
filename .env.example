# ==============================================================================
# ZOQNIVA AI — FRONTEND ENVIRONMENT VARIABLES (Public / Browser-safe only)
# ==============================================================================
# Configure these in your Vite / AI Studio environment.
# Never put Supabase service-role or Meta secret tokens in VITE_* variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
VITE_APP_NAME="Zoqniva AI"

# ==============================================================================
# SUPABASE EDGE FUNCTIONS SECRETS (Server-side ONLY — NEVER prefix with VITE_)
# ==============================================================================
# Set these using `supabase secrets set KEY=VALUE` in your Supabase project:
# META_WHATSAPP_ACCESS_TOKEN="EAAG..."
# META_PHONE_NUMBER_ID="123456789012345"
# META_WABA_ID="123456789012345"
# META_APP_SECRET="your_meta_app_secret"
# META_WEBHOOK_VERIFY_TOKEN="your_custom_verify_token"
# SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
# GEMINI_API_KEY="optional_server_side_ai_key"
