{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run tests/unit tests/security/static-security.test.ts",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security/static-security.test.ts",
    "test:security:live": "vitest run tests/security/rls-live.test.ts",
    "test:whatsapp": "vitest run tests/unit/whatsapp.integration.test.ts",
    "test:integration": "vitest run tests/integration/supabase-persistence.live.test.ts",
    "test:live:whatsapp": "RUN_LIVE_WHATSAPP_TEST=true vitest run tests/integration/whatsapp-live.test.ts",
    "test:e2e": "playwright test --project=browser-ui",
    "test:e2e:live": "playwright test --project=live-e2e",
    "test:db": "supabase test db",
    "test:edge": "deno test --allow-env --allow-net tests/edge/edge_functions_test.ts",
    "test:report": "node scripts/generate-qa-report.mjs",
    "test:ci": "npm run lint && npm run build && npm run test && npm run test:report"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
